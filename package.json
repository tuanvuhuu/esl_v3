{
  "name": "esl-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:task": "node scripts/test-task.mjs",
    "test:recent": "node scripts/test-task.mjs recent",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/db/seed.ts",
    "db:seed:reset": "node --env-file-if-exists=.env.local --import tsx src/db/seed.ts --reset",
    "db:set-password": "node --env-file-if-exists=.env.local --import tsx src/db/set-password.ts",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "files:migrate": "node scripts/migrate-files-to-supabase.mjs",
    "files:archive": "node scripts/archive-old-files-to-drive.mjs",
    "db:backup": "node scripts/backup-db-to-drive.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@primer/octicons-react": "^19.40.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.41.0",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.43.0",
    "googleapis": "^186.0.0",
    "moment": "^2.31.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.4",
    "react-is": "^19.3.0",
    "react-number-format": "^5.4.5",
    "ts-fsrs": "^5.4.2",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-is": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
